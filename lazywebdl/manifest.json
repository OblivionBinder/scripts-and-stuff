{
  "manifest_version": 3,
  "name": "lazywebdl",
  "version": "1.0",

  "description": "Ez download of stuff while including creator/author/source (and hopefully more later)",
  
  "permissions": [
    "activeTab",
    "webRequest",
    "webRequestBlocking",
    "scripting"
  ], 

  "host_permissions": [
    "*://*.x.com/*",
    "*://*.xcancel.com/*",
    "*://*.reddit.com/*",
    "*://*.royalroad.com/*",
    "*://*.dmi.dk/*",
    "*://*.example.com/*",
    "*://*.example.org/*"
  ],

  "background": {
    "scripts": ["/dist/background.bundled.js"],
    "type": "module"
  },

  "commands": {
    "save-content": {
      "suggested_key": {
        "default": "Ctrl+Alt+S"
      },
      "description": "Reserved for the actual saving"
    },
    "run-command": {
      "suggested_key": {
        "default": "Ctrl+Alt+W"
      },
      "description": "testing shit ig"
    }
  },

  "browser_specific_settings": {
    "gecko": {
      "id": "@lazywebdl-addon",
      "data_collection_permissions": {
        "required": [
          "websiteActivity",
          "websiteContent"
        ]
      },
      "strict_min_version": "142.0"
    }
  }
}